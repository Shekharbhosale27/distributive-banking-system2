# Runtime environment ("development" | "production")
NODE_ENV="development"
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SQLite database path (for production use a persistent volume path)
DB_PATH="./data/meridian_bank.db"

# Security secrets (generate strong 32+ byte random secrets in production)
SESSION_SECRET="dev-session-secret-change-in-production"
QR_SIGNING_SECRET="dev-qr-signing-secret-change-in-production"

# Local development seeding (NEVER enable in production)
# When ALLOW_DEV_SEED=true and NODE_ENV!=production, seeds sample accounts and manager/1234 (forced password change).
ALLOW_DEV_SEED="true"

# Production manager bootstrap (required when initializing an empty production DB)
BOOTSTRAP_MANAGER_USERNAME=""
BOOTSTRAP_MANAGER_PASSWORD=""

# Payment / UPI / Bank Transfer Provider Adapter
PAYMENT_PROVIDER_MODE="sandbox"
PAYMENT_PROVIDER_BASE_URL=""
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-in-production"

# Aadhaar KYC Verification Provider Adapter (e.g., approved UIDAI KUA / DigiLocker / Karza / Signzy)
KYC_PROVIDER_MODE="sandbox"
KYC_PROVIDER_BASE_URL=""
KYC_PROVIDER_API_KEY=""

# SMS Notification Provider Adapter ("sandbox" | "live")
# Supported adapters: auto | twilio | msg91 | fast2sms | webhook
SMS_PROVIDER_MODE="sandbox"
SMS_PROVIDER="auto"
SMS_PROVIDER_ACCOUNT_SID=""
SMS_PROVIDER_AUTH_TOKEN=""
SMS_PROVIDER_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="MRDBNK"
FAST2SMS_API_KEY=""
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_BEARER_TOKEN=""

# Email / Gmail Notification Provider Adapter ("sandbox" | "live")
# Supported adapters: auto | gmail_smtp | resend | sendgrid | webhook
# Note: 1P Google Workspace Gmail API (gmail.send) uses client-side Google Sign-In OAuth configured via firebase-applet-config.json
EMAIL_PROVIDER_MODE="sandbox"
EMAIL_PROVIDER="auto"
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="Meridian Trust Bank"
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_BEARER_TOKEN=""

# Operational Limits (minor units / paise: 2500000 = INR 25,000.00)
EMPLOYEE_MAX_ADJUSTMENT_PAISE="2500000"
